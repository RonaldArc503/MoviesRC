<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgPrimary">

    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/accentRed" />

    <TextView
        android:id="@+id/tv_next_loader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="54dp"
        android:background="@android:color/transparent"
        android:text="Cargando siguiente episodio..."
        android:textColor="@color/white"
        android:textSize="14sp"
        android:visibility="gone"
        android:translationY="14dp" />

    <include layout="@layout/player_control_overlay" />

    <include layout="@layout/player_double_tap_overlay" />

    <Button
        android:id="@+id/btn_skip_intro"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:minWidth="140dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="90dp"
        android:background="@drawable/bg_next_episode_button"
        android:elevation="8dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:drawableStart="@drawable/ic_skip_next"
        android:drawablePadding="8dp"
        android:text="Saltar intro"
        android:textAllCaps="false"
        android:textColor="@color/text_next_episode"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:visibility="gone" />

    <Button
        android:id="@+id/btn_next_episode"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:minWidth="170dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="90dp"
        android:background="@drawable/bg_next_episode_button"
        android:elevation="8dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:drawableStart="@drawable/ic_skip_next"
        android:drawablePadding="8dp"
        android:text="Siguiente episodio"
        android:textAllCaps="false"
        android:textColor="@color/text_next_episode"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:visibility="gone" />

</FrameLayout>
