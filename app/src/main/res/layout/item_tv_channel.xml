<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:background="@drawable/selector_channel_card"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:elevation="3dp">

    <!-- ── ÁREA DE LOGO / BANNER (Mantiene dimensiones y proporciones intactas) ── -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="100dp"
        app:cardCornerRadius="13dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#0A0D15">

        <!-- Foto / Logo del canal calibrado (-20% de ancho -> 1.08x) manteniendo la altura -->
        <ImageView
            android:id="@+id/iv_channel_logo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:scaleX="1.08"
            android:paddingStart="10dp"
            android:paddingTop="12dp"
            android:paddingEnd="10dp"
            android:paddingBottom="12dp"
            android:contentDescription="@string/app_name" />

        <!-- Badge EN VIVO flotante (esquina superior izquierda) -->
        <LinearLayout
            android:id="@+id/ll_badge_live"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_gravity="top|start"
            android:layout_margin="6dp"
            android:background="@drawable/bg_live_badge"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingEnd="7dp">

            <View
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:background="@drawable/dot_active" />

            <TextView
                android:id="@+id/tv_channel_badge_live"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.04"
                android:text="EN VIVO"
                android:textColor="#FFFFFF"
                android:textSize="8.5sp" />
        </LinearLayout>

        <!-- Badge Calidad/Tipo (esquina superior derecha) -->
        <TextView
            android:id="@+id/tv_channel_source_type"
            android:layout_width="wrap_content"
            android:layout_height="19dp"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:background="@drawable/bg_badge_hd"
            android:gravity="center"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:text="HD"
            android:textColor="#E0E6F0"
            android:textSize="8.5sp"
            android:fontFamily="sans-serif-bold" />

    </androidx.cardview.widget.CardView>

    <!-- Línea divisoria sutil -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1C2332" />

    <!-- ── ÁREA DE TÍTULO Y ACCIÓN ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="11dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_channel_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tv_channel_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#7A8699"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Indicador de reproducción -->
        <ImageView
            android:id="@+id/iv_play_indicator"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="6dp"
            android:contentDescription="Reproducir"
            android:src="@drawable/ic_play_circle"
            android:tint="@color/accentRed" />

    </LinearLayout>

</LinearLayout>