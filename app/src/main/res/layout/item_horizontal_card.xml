<?xml version="1.0" encoding="utf-8"?>
<!--
    item_horizontal_card.xml  – Card de póster estilo Netflix/REX
    Incluye: badge de rating, imagen de póster, barra de progreso,
             título y año en el área de texto inferior.
    El tamaño real (ancho/alto) lo setea HomeAdapter programáticamente
    según TV o móvil.
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#161A24">

    <!-- Stack vertical: imagen + barra progreso + texto -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ── ZONA DE IMAGEN ── -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Poster image -->
            <ImageView
                android:id="@+id/iv_poster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/placeholder_poster" />

            <!-- Gradiente inferior para legibilidad del rating -->
            <View
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_poster_gradient_bottom" />

            <!-- Rating badge (esquina superior izquierda) -->
            <TextView
                android:id="@+id/tv_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="6dp"
                android:textColor="#FFC800"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/bg_rating_badge"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone" />

            <!-- Play overlay badge (estilo Netflix para continuar viendo) -->
            <ImageView
                android:id="@+id/iv_play_overlay"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_play"
                android:background="@drawable/bg_card_play_badge"
                android:padding="9dp"
                app:tint="#FFFFFF"
                android:visibility="gone" />

            <!-- Overlay Quitar de la lista al mantener presionado en Favoritos -->
            <FrameLayout
                android:id="@+id/overlay_remove_fav"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#E60A0C10"
                android:clickable="true"
                android:focusable="false"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_clear"
                        app:tint="#E63540"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center"
                        android:text="Quitar de\nla lista"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>
            </FrameLayout>

        </FrameLayout>

        <!-- ── BARRA DE PROGRESO (roja, estilo Netflix) ── -->
        <FrameLayout
            android:id="@+id/progress_container"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:visibility="gone">

            <!-- Fondo gris de la barra -->
            <View
                android:id="@+id/progress_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#2A2D38" />

            <!-- Relleno rojo (ancho se setea programáticamente) -->
            <View
                android:id="@+id/progress_fg"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:background="#E50914" />
        </FrameLayout>

        <!-- ── ZONA DE TEXTO ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="7dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_year"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#D0D3DE"
                android:textSize="11sp"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>