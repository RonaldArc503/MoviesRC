<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_dark"
    android:fitsSystemWindows="true">

    <!-- Hero Carousel Container -->
    <FrameLayout
        android:id="@+id/hero_container"
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:elevation="4dp"
        android:outlineProvider="none"
        android:visibility="gone">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/vp_hero"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/dots_container"
            android:layout_width="wrap_content"
            android:layout_height="12dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="9dp"
            android:gravity="center"
            android:orientation="horizontal" />
    </FrameLayout>

    <!-- Top Header Bar with Back Button, Title and Search -->
    <RelativeLayout
        android:id="@+id/top_header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:elevation="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@drawable/gradient_controls_top">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_nav_item_touch"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/white"
            android:contentDescription="Volver" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/btn_back"
            android:layout_marginStart="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DORAMAS"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_card_play_badge"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="LATINO"
                android:textColor="#E63540"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_search"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_nav_item_touch"
            android:src="@drawable/ic_search"
            android:tint="@color/white"
            android:contentDescription="Buscar" />
    </RelativeLayout>

    <!-- Vertical RecyclerView for Doramas Sections -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_doramas_sections"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingTop="420dp"
        android:paddingBottom="100dp" />

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/accentRed"
        android:visibility="gone" />

    <!-- Mobile Floating Navigation Card (Bottom) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottom_menu"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="@color/bottom_nav_bg"
        app:cardCornerRadius="32dp"
        app:cardElevation="14dp"
        app:strokeColor="@color/bottom_nav_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Inicio -->
            <LinearLayout
                android:id="@+id/menu_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_nav_item_touch"
                android:clickable="true"
                android:focusable="false"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_home"
                    android:tint="@color/bottom_nav_tint" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Inicio"
                    android:textColor="@color/bottom_nav_tint"
                    android:textSize="10sp"
                    android:maxLines="1" />
            </LinearLayout>

            <!-- Buscar -->
            <LinearLayout
                android:id="@+id/menu_buscar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_nav_item_touch"
                android:clickable="true"
                android:focusable="false"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_search"
                    android:tint="@color/bottom_nav_tint" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Buscar"
                    android:textColor="@color/bottom_nav_tint"
                    android:textSize="10sp"
                    android:maxLines="1" />
            </LinearLayout>

            <!-- Canales -->
            <LinearLayout
                android:id="@+id/menu_canales"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_nav_item_touch"
                android:clickable="true"
                android:focusable="false"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_chanels"
                    android:tint="@color/bottom_nav_tint" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Canales"
                    android:textColor="@color/bottom_nav_tint"
                    android:textSize="10sp"
                    android:maxLines="1" />
            </LinearLayout>

            <!-- Novelas -->
            <LinearLayout
                android:id="@+id/menu_novelas"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_nav_item_touch"
                android:clickable="true"
                android:focusable="false"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_novelas"
                    android:tint="@color/bottom_nav_tint" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Novelas"
                    android:textColor="@color/bottom_nav_tint"
                    android:textSize="10sp"
                    android:maxLines="1" />
            </LinearLayout>

            <!-- Doramas (Active / Highlighted) -->
            <LinearLayout
                android:id="@+id/menu_doramas"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_nav_item_touch"
                android:clickable="true"
                android:focusable="false"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_doramas"
                    android:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Doramas"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="10sp"
                    android:maxLines="1" />
            </LinearLayout>

            <!-- Ajustes -->
            <LinearLayout
                android:id="@+id/menu_ajustes"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_nav_item_touch"
                android:clickable="true"
                android:focusable="false"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_settings"
                    android:tint="@color/bottom_nav_tint" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Ajustes"
                    android:textColor="@color/bottom_nav_tint"
                    android:textSize="10sp"
                    android:maxLines="1" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
