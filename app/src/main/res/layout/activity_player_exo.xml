<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#050505"
        android:keepScreenOn="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        app:resize_mode="fit" />

    <ProgressBar
        android:id="@+id/buffer_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone" />

    <include layout="@layout/player_control_overlay" />

    <include layout="@layout/player_double_tap_overlay" />

    <Button
        android:id="@+id/btn_skip_intro"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:minWidth="140dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="90dp"
        android:background="@drawable/bg_next_episode_button"
        android:elevation="8dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:drawableStart="@drawable/ic_skip_next"
        android:drawablePadding="8dp"
        android:text="Saltar intro"
        android:textAllCaps="false"
        android:textColor="@color/text_next_episode"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:visibility="gone" />

    <Button
        android:id="@+id/btn_next_episode"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:minWidth="170dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="90dp"
        android:background="@drawable/bg_next_episode_button"
        android:elevation="8dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:drawableStart="@drawable/ic_skip_next"
        android:drawablePadding="8dp"
        android:text="Siguiente episodio"
        android:textAllCaps="false"
        android:textColor="@color/text_next_episode"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:visibility="gone" />

</FrameLayout>
