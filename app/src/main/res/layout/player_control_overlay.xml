<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/control_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:visibility="gone"
    android:background="@android:color/transparent">

    <!-- ── SCRIM TOP ── -->
    <View
        android:id="@+id/scrim_top"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_alignParentTop="true"
        android:background="@drawable/gradient_controls_top" />

    <!-- ── SCRIM BOTTOM ── -->
    <View
        android:id="@+id/scrim_bottom"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/gradient_controls_bottom" />

    <!-- ══════════════ TOP BAR ══════════════ -->
    <RelativeLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <!-- Botón volver -->
        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/player_chip_round"
            android:elevation="4dp"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/player_icon"
            android:contentDescription="@null" />

        <!-- Título y Badge EN VIVO -->
        <LinearLayout
            android:id="@+id/ll_title_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/btn_back"
            android:layout_toStartOf="@+id/btn_lock"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/tv_player_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.02"
                android:maxLines="1"
                android:textColor="@color/player_text_soft"
                android:textSize="15sp" />

            <!-- Badge EN VIVO -->
            <LinearLayout
                android:id="@+id/ll_live_badge"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_live_badge"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:visibility="gone">

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/dot_active" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.04"
                    android:text="EN VIVO"
                    android:textColor="@color/white"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Botón bloquear pantalla -->
        <ImageButton
            android:id="@+id/btn_lock"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/player_chip_round"
            android:elevation="4dp"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_lock_open"
            android:tint="@color/player_icon"
            android:contentDescription="@null" />

    </RelativeLayout>

    <!-- ══════════════ CENTER CONTROLS ══════════════ -->
    <LinearLayout
        android:id="@+id/center_controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottom_bar"
        android:layout_below="@id/top_bar"
        android:orientation="horizontal"
        android:gravity="center"
        android:baselineAligned="false">

        <!-- Retroceder 10s -->
        <LinearLayout
            android:id="@+id/ll_skip_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="32dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btn_skip_back"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/player_chip_round"
                android:elevation="4dp"
                android:padding="11dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_skip_back_10"
                android:tint="@color/player_icon"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- Play / Pausa central -->
        <ImageButton
            android:id="@+id/btn_play_center"
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:background="@drawable/bg_player_center_button"
            android:elevation="8dp"
            android:padding="20dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_play"
            android:tint="@color/player_icon"
            android:contentDescription="@null" />

        <!-- Adelantar 10s -->
        <LinearLayout
            android:id="@+id/ll_skip_forward"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btn_skip_forward"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/player_chip_round"
                android:elevation="4dp"
                android:padding="11dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_skip_forward_10"
                android:tint="@color/player_icon"
                android:contentDescription="@null" />
        </LinearLayout>

    </LinearLayout>

    <!-- ══════════════ BOTTOM CONTROLS ══════════════ -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="6dp">

        <!-- Contenedor Barra de Progreso (se oculta en Canales en Vivo) -->
        <LinearLayout
            android:id="@+id/ll_seekbar_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_current_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:minWidth="38dp"
                android:text="0:00"
                android:textColor="@color/player_text_soft"
                android:textSize="12sp"
                android:letterSpacing="0.02" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:clipChildren="false">

                <SeekBar
                    android:id="@+id/player_seekbar"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:layout_gravity="center_vertical"
                    android:max="1000"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:progress="0"
                    android:progressDrawable="@drawable/player_seekbar_progress"
                    android:splitTrack="false"
                    android:thumb="@drawable/player_thumb_selector"
                    android:thumbOffset="6dp" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:minWidth="38dp"
                android:gravity="end"
                android:text="0:00"
                android:textColor="@color/player_icon_secondary"
                android:textSize="12sp"
                android:letterSpacing="0.02" />
        </LinearLayout>

        <!-- Fila de controles secundarios distribuida en todo el ancho -->
        <LinearLayout
            android:id="@+id/right_controls"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/fl_subtitles"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <ImageButton
                    android:id="@+id/btn_subtitles"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:background="@drawable/player_chip_round"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_subtitles"
                    android:tint="@color/player_icon"
                    android:contentDescription="@null" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/fl_audio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <ImageButton
                    android:id="@+id/btn_audio"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:background="@drawable/player_chip_round"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_audio"
                    android:tint="@color/player_icon"
                    android:contentDescription="@null" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/fl_quality"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <ImageButton
                    android:id="@+id/btn_quality"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:background="@drawable/player_chip_round"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_quality"
                    android:tint="@color/player_icon"
                    android:contentDescription="@null" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/fl_cast"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <ImageButton
                    android:id="@+id/btn_cast"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:background="@drawable/player_chip_round"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_tv"
                    android:tint="@color/player_icon"
                    android:contentDescription="@null" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/fl_fullscreen"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <ImageButton
                    android:id="@+id/btn_fullscreen"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:background="@drawable/player_chip_round"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_fullscreen"
                    android:tint="@color/player_icon"
                    android:contentDescription="@null" />
            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- MediaRouteButton oculto -->
    <androidx.mediarouter.app.MediaRouteButton
        android:id="@+id/media_route_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</RelativeLayout>
