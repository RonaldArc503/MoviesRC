<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/selectableItemBackground">

    <FrameLayout
        android:layout_width="140dp"
        android:layout_height="79dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="6dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/img_episode_thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@null" />
        </androidx.cardview.widget.CardView>

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_episode_thumb_overlay"
            android:padding="8dp"
            android:src="@drawable/ic_play"
            app:tint="@color/white"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tv_episode_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="5dp"
            android:background="#CC000000"
            android:paddingStart="4dp"
            android:paddingTop="1dp"
            android:paddingEnd="4dp"
            android:paddingBottom="1dp"
            android:text="42m"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:visibility="gone" />

        <!-- Barra de progreso del episodio (estilo Netflix) -->
        <FrameLayout
            android:id="@+id/episode_progress_container"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:visibility="gone">

            <View
                android:id="@+id/episode_progress_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#80000000" />

            <View
                android:id="@+id/episode_progress_fg"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:background="#E63540" />
        </FrameLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_episode_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:text="1. Piloto"
            android:textColor="@color/player_text_soft"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_episode_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/player_icon_secondary"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>
</LinearLayout>
