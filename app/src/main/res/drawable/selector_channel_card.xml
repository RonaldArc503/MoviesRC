<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused (Android TV remote) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1A2232" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="#E63540" />
        </shape>
    </item>
    <!-- Pressed (Touch) -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#242E42" />
            <corners android:radius="14dp" />
            <stroke android:width="1.5dp" android:color="#80FFFFFF" />
        </shape>
    </item>
    <!-- Normal -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#131722" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#242D3D" />
        </shape>
    </item>
</selector>
