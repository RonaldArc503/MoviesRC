<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/player_chip_pressed" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#4DFFFFFF" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/player_chip_focus" />
            <corners android:radius="8dp" />
            <stroke android:width="1.5dp" android:color="@color/player_accent_red" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/player_chip_bg" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/player_chip_stroke" />
        </shape>
    </item>
</selector>
