<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/player_chip_pressed" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/player_chip_focus" />
            <stroke android:width="2dp" android:color="@color/player_thumb_border" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/player_chip_bg" />
            <stroke android:width="1dp" android:color="@color/player_chip_stroke" />
        </shape>
    </item>
</selector>
