<?xml version="1.0" encoding="utf-8"?>
<!--
    item_horizontal_card.xml (Android TV - Estilo HBO Max)
    Full-bleed poster vertical 2:3 y widescreen 16:9:
    - Sin caja inferior de texto externa que alargue la tarjeta
    - Imagen ocupa el 100% de la tarjeta con esquinas redondeadas (12dp)
    - Badge píldora blanca en esquina superior izquierda ("Recién Añadido", "Nuevo")
    - Ícono 3-puntos (⋮) en esquina superior derecha
    - Borde blanco nítido 3.5dp (bg_card_focused_hbomax)
    - Barra de progreso inferior y play overlay para continuar viendo
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_view_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#141720"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/tile_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 1. Imagen a sangre completa (Poster 100%) -->
        <ImageView
            android:id="@+id/iv_poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder_poster"
            android:contentDescription="@null" />

        <!-- 2. Gradiente inferior para legibilidad -->
        <View
            android:id="@+id/scrim_bottom"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_poster_gradient_bottom" />

        <!-- 3. BADGE HBO MAX: Píldora blanca en ESQUINA SUPERIOR IZQUIERDA -->
        <LinearLayout
            android:id="@+id/badge_wrapper_hbo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_badge_hbomax_white"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:elevation="2dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_badge_hbo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recién Añadido"
                android:textColor="#000000"
                android:textSize="9sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.04" />
        </LinearLayout>

        <!-- 4. ÍCONO 3-PUNTOS HBO MAX: ESQUINA SUPERIOR DERECHA -->
        <ImageView
            android:id="@+id/iv_more_tv"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_more_vert"
            app:tint="#CCFFFFFF"
            android:contentDescription="@null" />

        <!-- 5. Rating badge (debajo de 3-puntos si existe) -->
        <TextView
            android:id="@+id/tv_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="32dp"
            android:layout_marginEnd="8dp"
            android:textColor="#FFC800"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_rating_badge"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:visibility="gone" />

        <!-- 6. Play Overlay (para continuar viendo) -->
        <ImageView
            android:id="@+id/iv_play_overlay"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_play"
            android:background="@drawable/bg_card_play_badge"
            android:padding="10dp"
            app:tint="#FFFFFF"
            android:visibility="gone" />

        <!-- 7. Overlay de texto inferior integrado (dentro de la tarjeta) -->
        <LinearLayout
            android:id="@+id/text_container_overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp"
            android:paddingTop="4dp">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_year"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#8F94A6"
                android:textSize="10sp"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- 8. Barra de progreso de reproducción (borde inferior) -->
        <FrameLayout
            android:id="@+id/progress_container"
            android:layout_width="match_parent"
            android:layout_height="3.5dp"
            android:layout_gravity="bottom"
            android:visibility="gone">

            <View
                android:id="@+id/progress_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#40FFFFFF" />

            <View
                android:id="@+id/progress_fg"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:background="#FFFFFF" />
        </FrameLayout>

        <!-- 9. Overlay Quitar de la lista al mantener presionado en Favoritos -->
        <FrameLayout
            android:id="@+id/overlay_remove_fav"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#E60A0C10"
            android:clickable="true"
            android:focusable="false"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_clear"
                    app:tint="#E63540"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:text="Quitar de\nla lista"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_detail_play_hbomax"
                    android:fontFamily="sans-serif-bold"
                    android:paddingStart="12dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="3dp"
                    android:text="Confirmar"
                    android:textColor="#000000"
                    android:textSize="10sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- 10. Borde blanco de foco TV estilo HBO Max (3.5dp) -->
        <View
            android:id="@+id/tile_outline_tv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_card_focused_hbomax"
            android:visibility="gone" />

    </FrameLayout>

</androidx.cardview.widget.CardView>
