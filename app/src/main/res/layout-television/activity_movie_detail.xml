<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_detail_tv"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rexBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Seccion Hero con Backdrop y Columna de Informacion -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="540dp">

            <!-- 1. Imagen de Backdrop widescreen -->
            <ImageView
                android:id="@+id/img_backdrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@null" />

            <!-- 2. Gradiente lateral izquierdo para legibilidad absoluta del texto -->
            <View
                android:layout_width="660dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:background="@drawable/bg_detail_gradient_lateral" />

            <!-- 3. Gradiente inferior para fundir suavemente con el fondo sólido -->
            <View
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_detail_gradient_bottom" />

            <!-- 4. Gradiente superior sutil para el boton atras -->
            <View
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_gravity="top"
                android:background="@drawable/gradient_detail_top" />

            <!-- 5. Boton Volver circular estilo HBO Max -->
            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="48dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_detail_circle_btn"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/white"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@id/btn_detail_play"
                android:contentDescription="@null" />

            <!-- 6. Columna izquierda de informacion (ancho restringido ~560dp) -->
            <LinearLayout
                android:layout_width="560dp"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:orientation="vertical"
                android:paddingStart="48dp"
                android:paddingEnd="16dp"
                android:paddingBottom="20dp">

                <!-- Tag categoria / marca -->
                <TextView
                    android:id="@+id/tv_edition_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.12"
                    android:text="PELÍCULA"
                    android:textColor="#8E93A4"
                    android:textSize="11sp" />

                <!-- Titulo del contenido -->
                <TextView
                    android:id="@+id/tv_detail_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-black"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:shadowColor="#99000000"
                    android:shadowDy="2"
                    android:shadowRadius="8"
                    android:text="Nombre de la Película"
                    android:textColor="@color/white"
                    android:textSize="36sp" />

                <!-- Fila de metadatos (Calificacion, ano, duracion, match, calidad) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_meta_badge_hbomax"
                        android:fontFamily="sans-serif-bold"
                        android:paddingStart="6dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="2dp"
                        android:text="16+"
                        android:textColor="#D1D5DB"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="2h 14m"
                        android:textColor="#A0A5B5"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tv_year"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="2024"
                        android:textColor="#A0A5B5"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_match"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="97% para ti"
                        android:textColor="#4ADE80"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/badge_quality"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_meta_badge_hbomax"
                        android:fontFamily="sans-serif-bold"
                        android:paddingStart="6dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="2dp"
                        android:text="4K"
                        android:textColor="#D1D5DB"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Boton Primario: "Ver ahora" / "Reproducir" -->
                <LinearLayout
                    android:id="@+id/btn_detail_play"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_detail_play_hbomax"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="24dp"
                    android:paddingEnd="28dp"
                    android:nextFocusUp="@id/btn_back"
                    android:nextFocusDown="@id/btn_mylist">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_play"
                        app:tint="@android:color/black"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tv_detail_play_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Ver ahora"
                        android:textColor="@android:color/black"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- Fila de Acciones Secundarias (Mi Lista, Calificar) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Boton Mi Lista -->
                    <LinearLayout
                        android:id="@+id/btn_mylist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_detail_action_btn"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="8dp"
                        android:nextFocusUp="@id/btn_detail_play"
                        android:nextFocusDown="@id/rv_more_like_this"
                        android:nextFocusRight="@id/btn_rate">

                        <ImageView
                            android:id="@+id/img_mylist_icon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_add"
                            app:tint="@color/player_icon"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/tv_mylist_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="Mi Lista"
                            android:textColor="@color/player_icon_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Boton Calificar -->
                    <LinearLayout
                        android:id="@+id/btn_rate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_detail_action_btn"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="8dp"
                        android:nextFocusUp="@id/btn_detail_play"
                        android:nextFocusDown="@id/rv_more_like_this"
                        android:nextFocusLeft="@id/btn_mylist">

                        <ImageView
                            android:id="@+id/img_rate_icon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_thumb_up"
                            app:tint="@color/player_icon"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/tv_rate_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="Calificar"
                            android:textColor="@color/player_icon_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Sinopsis -->
                <TextView
                    android:id="@+id/tv_synopsis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:ellipsize="end"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="4"
                    android:text="Sinopsis de la película va aquí, descripción breve de la trama y contexto general."
                    android:textColor="#CCD0DC"
                    android:textSize="14sp" />

                <!-- Generos / Reparto -->
                <TextView
                    android:id="@+id/tv_cast_crew"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="2dp"
                    android:text="Drama, Acción"
                    android:textColor="#8A8F9E"
                    android:textSize="12sp"
                    android:visibility="gone" />

            </LinearLayout>
        </FrameLayout>

        <!-- Seccion: Mas como esta -->
        <TextView
            android:id="@+id/tv_more_like_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-bold"
            android:text="Más como esta"
            android:textColor="@color/white"
            android:textSize="20sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_more_like_this"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingStart="48dp"
            android:paddingEnd="24dp"
            android:nextFocusUp="@id/btn_mylist"
            tools:listitem="@layout/item_poster_card" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="120dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
